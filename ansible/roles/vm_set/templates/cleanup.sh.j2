#!/bin/bash

set -e

# Parse command line arguments
TESTBED_FILE=""
TESTBED_NAME=""
CLEAN_ALL=true
DRY_RUN=false

function usage {
  echo "Usage: $0 [OPTIONS]"
  echo "Options:"
  echo "  --testbed-file FILE  Specify a testbed file to read"
  echo "  --testbed-name NAME  Specify a testbed name to clean up"
  echo "  --dry-run            Show what would be done without actually doing it"
  echo "  --help, -h           Show this help message"
  echo
  echo "Examples:"
  echo "  $0                                  # Clean up everything"
  echo "  $0 --testbed-file testbed.yaml --testbed-name vms-t1-1  # Clean up specific testbed"
  echo "  $0 --testbed-file testbed.yaml --testbed-name vms-t1-1 --dry-run  # Show what would be cleaned up"
  exit 1
}

while [[ $# -gt 0 ]]; do
  key="$1"
  case $key in
    --testbed-file)
      TESTBED_FILE="$2"
      shift 2
      ;;
    --testbed-name)
      TESTBED_NAME="$2"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    --help|-h)
      usage
      ;;
    *)
      echo "Unknown option: $key"
      usage
      ;;
  esac
done

# Function to execute or simulate commands
execute() {
  if [ "$DRY_RUN" = true ]; then
    echo "[DRY RUN] Would execute: $@"
  else
    if [ "$1" = "echo" ]; then
      # Just echo the message even in non-dry-run mode
      "$@"
    else
      # Execute the command
      "$@"
    fi
  fi
}

# If testbed file and name are provided, extract VM pattern and PTF container name
VM_PATTERN=""
PTF_FILTER="name=ptf"

if [ -n "$TESTBED_FILE" ] && [ -n "$TESTBED_NAME" ]; then
  echo "Reading testbed file $TESTBED_FILE for testbed $TESTBED_NAME"
  CLEAN_ALL=false

  # Check if testbed file exists
  if [ ! -f "$TESTBED_FILE" ]; then
    echo "Testbed file $TESTBED_FILE not found"
    exit 1
  fi

  # Extract information from testbed file
  if [[ "$TESTBED_FILE" == *.yaml ]]; then
    # For YAML files
    if ! command -v python3 &> /dev/null; then
      echo "Python3 is required to parse YAML files"
      exit 1
    fi

    # Use Python to extract VM base and PTF name
    TESTBED_INFO=$(python3 -c "
import yaml
import sys

try:
    with open('$TESTBED_FILE', 'r') as f:
        data = yaml.safe_load(f)

    found = False
    for tb in data:
        if tb.get('conf-name') == '$TESTBED_NAME':
            found = True
            vm_base = tb.get('vm_base', '')
            ptf = tb.get('ptf', '')
            print(f'{vm_base}|{ptf}')
            break

    if not found:
        print('|')
except Exception as e:
    print(f'Error: {e}', file=sys.stderr)
    print('|')
")

    VM_BASE=$(echo "$TESTBED_INFO" | cut -d'|' -f1)
    PTF_NAME=$(echo "$TESTBED_INFO" | cut -d'|' -f2)

  elif [[ "$TESTBED_FILE" == *.csv ]]; then
    # For CSV files
    LINE=$(grep "^$TESTBED_NAME," "$TESTBED_FILE" || echo "")
    if [ -z "$LINE" ]; then
      echo "Testbed $TESTBED_NAME not found in $TESTBED_FILE"
      exit 1
    fi

    # Extract VM base and PTF name from CSV
    VM_BASE=$(echo "$LINE" | cut -d',' -f8)
    PTF_NAME=$(echo "$LINE" | cut -d',' -f4)
  else
    echo "Unsupported testbed file format: $TESTBED_FILE"
    exit 1
  fi

  # Set VM pattern based on VM base
  if [ -n "$VM_BASE" ]; then
    # Extract the prefix (first 4 characters) to match all related VMs
    VM_PREFIX=$(echo "$VM_BASE" | cut -c1-4)
    VM_PATTERN="${VM_PREFIX}.*"
    echo "Using VM pattern: $VM_PATTERN"
  else
    echo "No VM base found for testbed $TESTBED_NAME"
  fi

  # Set PTF container filter
  if [ -n "$PTF_NAME" ]; then
    PTF_FILTER="name=${PTF_NAME}"
    echo "Using PTF filter: $PTF_FILTER"
  else
    PTF_FILTER=""
    echo "No specific PTF name found, skipping PTF container cleanup"
  fi
fi

# Handle VM cleanup
if [ "$CLEAN_ALL" = true ] || [ -z "$VM_PATTERN" ]; then
  if [ "$CLEAN_ALL" = true ]; then
    execute echo "Cleaning up all VMs"

    # Get running VMs for dry run display
    RUNNING_VMS=$(virsh list --state-running --name 2>/dev/null || echo "")
    if [ -n "$RUNNING_VMS" ]; then
      execute echo "Would stop these running VMs:"
      for VM in $RUNNING_VMS; do
        execute echo "  - $VM"
        if [ "$DRY_RUN" = false ]; then
          virsh destroy $VM
        fi
      done
    else
      execute echo "No running VMs found"
    fi

    # Get paused VMs for dry run display
    PAUSED_VMS=$(virsh list --state-paused --name 2>/dev/null || echo "")
    if [ -n "$PAUSED_VMS" ]; then
      execute echo "Would stop these paused VMs:"
      for VM in $PAUSED_VMS; do
        execute echo "  - $VM"
        if [ "$DRY_RUN" = false ]; then
          virsh destroy $VM
        fi
      done
    else
      execute echo "No paused VMs found"
    fi

    # Get all VMs for dry run display
    ALL_VMS=$(virsh list --all --name 2>/dev/null || echo "")
    if [ -n "$ALL_VMS" ]; then
      execute echo "Would undefine these VMs:"
      for VM in $ALL_VMS; do
        execute echo "  - $VM"
        if [ "$DRY_RUN" = false ]; then
          virsh undefine $VM
        fi
      done
    else
      execute echo "No defined VMs found"
    fi

    # List disks for dry run display
    DISKS=$(ls {{ root_path }}/disks/* 2>/dev/null || echo "")
    if [ -n "$DISKS" ]; then
      execute echo "Would remove these VM disks:"
      for DISK in $DISKS; do
        execute echo "  - $DISK"
      done
      if [ "$DRY_RUN" = false ]; then
        rm -f {{ root_path }}/disks/*
      fi
    else
      execute echo "No VM disks found"
    fi

    # List OVS bridges for dry run display
    BRIDGES=$(ovs-vsctl list-br 2>/dev/null || echo "")
    if [ -n "$BRIDGES" ]; then
      execute echo "Would remove these OVS bridges:"
      for BRIDGE in $BRIDGES; do
        execute echo "  - $BRIDGE"
        if [ "$DRY_RUN" = false ]; then
          ovs-vsctl del-br $BRIDGE
        fi
      done
    else
      execute echo "No OVS bridges found"
    fi
  else
    execute echo "No VM pattern specified for testbed, skipping VM cleanup"
  fi
else
  # Get list of VMs matching the pattern
  MATCHING_VMS=$(virsh list --all --name 2>/dev/null | grep -E "$VM_PATTERN" || echo "")

  if [ -z "$MATCHING_VMS" ]; then
    execute echo "No VMs found matching pattern: $VM_PATTERN"
  else
    execute echo "Found VMs matching pattern: $VM_PATTERN"
    for VM in $MATCHING_VMS; do
      execute echo "  - $VM"
    done

    # Stop matching VMs if they're running
    for VM in $MATCHING_VMS; do
      if virsh list --state-running --name 2>/dev/null | grep -q "^$VM$"; then
        execute echo "Would stop running VM: $VM"
        if [ "$DRY_RUN" = false ]; then
          virsh destroy $VM
        fi
      fi
    done

    # Stop matching VMs if they're paused
    for VM in $MATCHING_VMS; do
      if virsh list --state-paused --name 2>/dev/null | grep -q "^$VM$"; then
        execute echo "Would stop paused VM: $VM"
        if [ "$DRY_RUN" = false ]; then
          virsh destroy $VM
        fi
      fi
    done

    # Undefine matching VMs
    for VM in $MATCHING_VMS; do
      if virsh list --all --name 2>/dev/null | grep -q "^$VM$"; then
        execute echo "Would undefine VM: $VM"
        if [ "$DRY_RUN" = false ]; then
          virsh undefine $VM
        fi
      fi
    done

    # List matching VM disks for dry run display
    MATCHING_DISKS=$(ls {{ root_path }}/disks/*${VM_BASE}* 2>/dev/null || echo "")
    if [ -n "$MATCHING_DISKS" ]; then
      execute echo "Would remove these VM disks:"
      for DISK in $MATCHING_DISKS; do
        execute echo "  - $DISK"
      done
      if [ "$DRY_RUN" = false ]; then
        rm -f {{ root_path }}/disks/*${VM_BASE}*
      fi
    else
      execute echo "No matching VM disks found"
    fi

    # List matching OVS bridges for dry run display
    for VM in $MATCHING_VMS; do
      MATCHING_BRIDGES=$(ovs-vsctl list-br 2>/dev/null | grep -E "br-${VM}-[0-9]+" || echo "")
      if [ -n "$MATCHING_BRIDGES" ]; then
        execute echo "Would remove these bridges for VM $VM:"
        for BRIDGE in $MATCHING_BRIDGES; do
          execute echo "  - $BRIDGE"
          if [ "$DRY_RUN" = false ]; then
            ovs-vsctl del-br $BRIDGE
          fi
        done
      fi
    done
  fi
fi

# Handle exabgp processes
if [ "$CLEAN_ALL" = true ]; then
  execute echo "Would stop exabgp processes in all PTF containers"
  if [ "$DRY_RUN" = false ]; then
    ptf_container_names=$(docker ps | grep ptf | awk '{print $NF}')
    for ptf in $ptf_container_names; do
      process_name="$(docker exec $ptf supervisorctl status 2>/dev/null | awk '{print $1}' || echo "")"
      for process in $process_name; do
        process_status="$(docker exec $ptf supervisorctl status 2>/dev/null | grep $process | awk '{print $2}' || echo "")"
        if [[ $process_status == "RUNNING" ]]; then
          docker exec $ptf supervisorctl stop $process
        fi
      done
    done
  fi
elif [ -n "$PTF_FILTER" ]; then
  execute echo "Would stop exabgp processes in PTF containers matching: $PTF_FILTER"
  if [ "$DRY_RUN" = false ]; then
    ptf_container_names=$(docker ps | grep "${PTF_NAME}" | awk '{print $NF}')
    for ptf in $ptf_container_names; do
      process_name="$(docker exec $ptf supervisorctl status 2>/dev/null | awk '{print $1}' || echo "")"
      for process in $process_name; do
        process_status="$(docker exec $ptf supervisorctl status 2>/dev/null | grep $process | awk '{print $2}' || echo "")"
        if [[ $process_status == "RUNNING" ]]; then
          docker exec $ptf supervisorctl stop $process
        fi
      done
    done
  fi
else
  execute echo "Skipping exabgp process cleanup as no specific PTF name was found"
fi

# Handle docker container cleanup
if [ "$CLEAN_ALL" = true ]; then
  # List running containers for dry run display
  RUNNING_CONTAINERS=$(docker ps -q 2>/dev/null || echo "")
  if [ -n "$RUNNING_CONTAINERS" ]; then
    execute echo "Would stop these running docker containers:"
    for CONTAINER in $RUNNING_CONTAINERS; do
      CONTAINER_NAME=$(docker ps --format "{{.Names}}" -f "id=$CONTAINER" 2>/dev/null || echo "")
      execute echo "  - $CONTAINER_NAME ($CONTAINER)"
    done
    if [ "$DRY_RUN" = false ]; then
      docker stop $RUNNING_CONTAINERS
    fi
  else
    execute echo "No running docker containers found"
  fi

  # List all containers for dry run display
  ALL_CONTAINERS=$(docker ps -a -q 2>/dev/null || echo "")
  if [ -n "$ALL_CONTAINERS" ]; then
    execute echo "Would remove these docker containers:"
    for CONTAINER in $ALL_CONTAINERS; do
      CONTAINER_NAME=$(docker ps -a --format "{{.Names}}" -f "id=$CONTAINER" 2>/dev/null || echo "")
      execute echo "  - $CONTAINER_NAME ($CONTAINER)"
    done
    if [ "$DRY_RUN" = false ]; then
      docker rm -f $ALL_CONTAINERS
    fi
  else
    execute echo "No docker containers found"
  fi

  # List all images for dry run display
  ALL_IMAGES=$(docker images -q 2>/dev/null | uniq || echo "")
  if [ -n "$ALL_IMAGES" ]; then
    execute echo "Would remove these docker images:"
    for IMAGE in $ALL_IMAGES; do
      IMAGE_TAG=$(docker images --format "{{.Repository}}:{{.Tag}}" -f "reference=$IMAGE" 2>/dev/null || echo "")
      execute echo "  - $IMAGE_TAG ($IMAGE)"
    done
    if [ "$DRY_RUN" = false ]; then
      docker rmi -f $ALL_IMAGES
    fi
  else
    execute echo "No docker images found"
  fi
elif [ -n "$PTF_FILTER" ]; then
  # List matching PTF containers for dry run display
  PTF_CONTAINERS=$(docker ps -q --filter "name=${PTF_NAME}" 2>/dev/null || echo "")
  if [ -n "$PTF_CONTAINERS" ]; then
    execute echo "Would stop these PTF containers matching ${PTF_NAME}:"
    for CONTAINER in $PTF_CONTAINERS; do
      CONTAINER_NAME=$(docker ps --format "{{.Names}}" -f "id=$CONTAINER" 2>/dev/null || echo "")
      execute echo "  - $CONTAINER_NAME ($CONTAINER)"
    done
    if [ "$DRY_RUN" = false ]; then
      docker stop $PTF_CONTAINERS
    fi
  else
    execute echo "No running PTF containers found matching ${PTF_NAME}"
  fi

  # List all matching PTF containers for dry run display
  ALL_PTF_CONTAINERS=$(docker ps -a -q --filter "name=${PTF_NAME}" 2>/dev/null || echo "")
  if [ -n "$ALL_PTF_CONTAINERS" ]; then
    execute echo "Would remove these PTF containers matching ${PTF_NAME}:"
    for CONTAINER in $ALL_PTF_CONTAINERS; do
      CONTAINER_NAME=$(docker ps -a --format "{{.Names}}" -f "id=$CONTAINER" 2>/dev/null || echo "")
      execute echo "  - $CONTAINER_NAME ($CONTAINER)"
    done
    if [ "$DRY_RUN" = false ]; then
      docker rm -f $ALL_PTF_CONTAINERS
    fi
  else
    execute echo "No PTF containers found matching ${PTF_NAME}"
  fi
else
  execute echo "Skipping docker container cleanup as no specific PTF name was found"
fi

if [ "$DRY_RUN" = true ]; then
  echo "Dry run completed. No actions were taken."
else
  echo "Cleanup completed successfully"
fi
